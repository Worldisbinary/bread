{
  "title": "r/life simulation",
  "uid": "rlife",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {"type": "timeseries", "title": "Agent turns per minute", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (arm) (rate(rlife_agent_turns_total[5m])) * 60", "legendFormat": "{{arm}}"}]},
    {"type": "timeseries", "title": "Actions per minute by kind", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (kind) (rate(rlife_actions_total[5m])) * 60", "legendFormat": "{{kind}}"}]},
    {"type": "timeseries", "title": "Polarization (mean pairwise distance)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "rlife_polarization", "legendFormat": "{{arm}}"}]},
    {"type": "timeseries", "title": "Karma Gini", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "rlife_karma_gini", "legendFormat": "{{arm}}"}]},
    {"type": "timeseries", "title": "Turn latency p50 / p95 (s)", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(rlife_llm_turn_seconds_bucket[5m])))", "legendFormat": "p50"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(rlife_llm_turn_seconds_bucket[5m])))", "legendFormat": "p95"}]},
    {"type": "timeseries", "title": "Guardrails: rejections, interventions, parse errors per minute",
     "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
     "targets": [
       {"expr": "sum(rate(rlife_rejected_actions_total[5m])) * 60", "legendFormat": "rejected actions"},
       {"expr": "sum by (rule) (rate(rlife_guardrail_events_total[5m])) * 60", "legendFormat": "{{rule}}"},
       {"expr": "sum(rate(rlife_parse_errors_total[5m])) * 60", "legendFormat": "parse errors"}]},
    {"type": "stat", "title": "Share of items flagged for extremism", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 5},
     "targets": [{"expr": "rlife_flagged_share", "legendFormat": "{{arm}}"}]},
    {"type": "stat", "title": "Current tick", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 5},
     "targets": [{"expr": "rlife_tick", "legendFormat": "{{arm}}"}]}
  ]
}
