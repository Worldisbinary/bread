# Ages of Kingdoms, the r/life game, as a small web service (no embedding model, no research runs).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8000 \
    RLIFE_GAME_DIR=/app/runs/worlds \
    RLIFE_CACHE=/app/.cache/llm.sqlite
WORKDIR /app

COPY pyproject.toml README.md ./
COPY rlife ./rlife
RUN pip install .

RUN useradd --create-home rlife && mkdir -p /app/runs/worlds /app/.cache && chown -R rlife /app
USER rlife

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import os,urllib.request; urllib.request.urlopen(f'http://localhost:{os.environ[\"PORT\"]}/healthz')"
CMD ["python", "-m", "rlife", "serve"]
